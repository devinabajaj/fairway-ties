library(igraph)
# install.packages("igraph", version = "1.2.6")
# packageurl <- "http://cran.r-project.org/src/contrib/Archive/igraph/igraph_1.2.6.tar.gz"
# install.packages(packageurl, repos=NULL, type="source")
library(ggraph)
# install.packages("ggraph", version = "2.2.0")
# packageurl <- "http://cran.r-project.org/src/contrib/Archive/ggraph/ggraph_2.0.5.tar.gz"
# install.packages(packageurl, repos=NULL, type="source")
library(gplots)
# If you get a "try-fetch" error, uninstall and reinstall rlang
# load data####
nodes <- read.csv("~/Desktop/Teaching/! 2026_Spring_UG/Data/illustrative_nodes.csv")
#### illustrative graph####
# setwd("~Desktop/Soc and Networks")
# load data####
nodes <- read.csv("~/Desktop/Teaching/! 2026_Spring_UG/Data/illustrative_nodes.csv")
# load data####
nodes <- read.csv("~/Desktop/Soc and Networks/illustrative_nodes.csv")
summary(nodes)
edges <- read.csv("~/Desktop/Soc and Networks/illustrative_edges.csv")
summary(edges)
# make network object####
names(edges)
names(nodes)
# you might need the first column in the datasets to have the same name
net <- igraph::graph_from_data_frame(edges, directed = T, vertices = nodes) # set the network to directed
#graph_from_data_frame is how we turn two separate datasets into a single network in R
net # column for ID is now called "name"
is_simple(net) #does the network have loops or multiplex ties?
is_directed(net) #does the network have directed ties?
# 0 - default####
ggraph(net, layout = "stress") +
geom_edge_link() +
geom_node_point() +
ggnetwork::theme_blank() #I like to add this to make the background plain white rather than grey
# 1 - node labels####
ggraph(net, layout = "stress") +
geom_edge_link() +
geom_node_point() +
geom_node_label(aes(label = name), repel = T, size = 4, color = "grey50", fill = "#D7DFD7", label.size = 0.1) + #text in a box
# NOTE: When you create the network object,
# repel offsets the text from the node
# size is the size of the label
# color is the color of the label, box outline, and line connecting label to node
# fill is the color of the inside of the box
# label.size is the thickness of the box outline
ggnetwork::theme_blank()
ggraph(net, layout = "stress") +
geom_edge_link() +
geom_node_point() +
geom_node_text(aes(label = name), repel = T, size = 4, color = "#9fab9f") + #plain text
ggnetwork::theme_blank()
# 2 - transparency####
ggraph(net, layout = "stress") +
geom_edge_link(alpha = 0.1) + #alpha is opacity (0.1 means 10% opaque)
geom_node_point() +
geom_node_label(aes(label = name), repel = T, label.size = 0.1, alpha = 0.1, color = "grey50", fill = "#D7DFD7") +
ggnetwork::theme_blank()
# 3 - node shape, size, color####
ggraph(net, layout = "stress") +
geom_edge_link() +
geom_node_point(shape = ifelse(V(net)$gender == "F", "circle", "square")) +
#shapes can also be numeric, as shown in this chart: http://www.sthda.com/english/wiki/ggplot2-point-shapes
ggnetwork::theme_blank()
ggraph(net, layout = "stress") +
geom_edge_link() +
geom_node_point(size = 3) + #can be numeric, or based on a network variable
ggnetwork::theme_blank()
table(nodes$class)
mycols <- colorpanel(length(unique(nodes$class)), low = "#EFD9D3", high = "#402922")
mycols #I like using this to make sure colors are visually equidistant
ggraph(net, layout = "stress") +
geom_edge_link() +
geom_node_point(color = "black", #color is for the ring around the node
fill = ifelse(V(net)$class == 'MP', "#EFD9D3",
ifelse(V(net)$class == 'PC', "#98817B",
ifelse(V(net)$class == 'MP*2', "#402922",
"black"))), #fill is the color for the center
shape = 21) + #specific shapes needed to have both color and fill (shapes 21-25)
ggnetwork::theme_blank()
# 4 - edge direction, thickness, color####
ggraph(net, layout = "stress") +
geom_edge_link(arrow = grid::arrow(angle = 20, #how wide should the arrow be
length = unit(0.10, "in"), #how long should the arrow be
type = "closed")) + #vs open arrow
geom_node_point() +
ggnetwork::theme_blank()
ggraph(net, layout = "stress") +
geom_edge_link(aes(width = weight)) + #weight is the name of the variable for tie strength
scale_edge_width(range = c(0.15, 2)) + #default width is VERY wide, so I recommend reducing
geom_node_point() +
ggnetwork::theme_blank() +
theme(legend.position = "none") # I don't find the legend necessary in this case
ggraph(net, layout = "stress") +
geom_edge_link0(edge_color=ifelse(E(net)$friends == 1, "#82260d", "grey50")) + #friendly ties are red, others are grey
#NOTE to get colors to render you must use geom_edge_link0 rather than geom_edge_link
geom_node_point() +
ggnetwork::theme_blank()
# 5 - combination####
ggraph(net, layout = "stress") +
geom_edge_link0(edge_color=ifelse(E(net)$friends == 1, "#82260d", "grey50"),
aes(width = weight),
alpha = .5,
arrow = grid::arrow(angle = 10,
length = unit(0.10, "in"),
type = "closed")) +
scale_edge_color_manual(values = c("1" = "#82260d", "0" = "grey50")) + #new - need to add this to specify colors if edge_color is in AES
scale_edge_width(range = c(0.15, 1.5)) +
geom_node_point(size = V(net)$size <- igraph::degree(net, mode = "all")/3,
color = "black",
fill = ifelse(V(net)$class == 'MP', "#EFD9D3",
ifelse(V(net)$class == 'PC', "#98817B",
ifelse(V(net)$class == 'MP*2', "#402922",
"black"))),
shape = ifelse(V(net)$gender == "F", 21, 22)) +
ggnetwork::theme_blank(legend.position = "none") #put it all together!
class(E(net)$friends)
E(net)$friends <- as.factor(E(net)$friends)  # Convert to factor first
ggraph(net, layout = "stress") +
geom_edge_link(#edge_color=ifelse(E(net)$friends == 1, "#82260d", "grey50"),
aes(width = weight,
edge_color=E(net)$friends), # !!if you want to add start/end_cap and color, color needs to go in the aes
alpha = .5,
arrow = grid::arrow(angle = 10,
length = unit(0.10, "in"),
type = "closed"),
start_cap = circle(5, 'mm'),
end_cap = circle(5, 'mm')) +
scale_edge_color_manual(values = c("1" = "#82260d", "0" = "grey50")) + #new - need to add this to specify colors if edge_color is in AES
scale_edge_width(range = c(0.15, 1.5)) +
geom_node_point(size = V(net)$size <- igraph::degree(net, mode = "all")/3,
color = "black",
fill = ifelse(V(net)$class == 'MP', "#EFD9D3",
ifelse(V(net)$class == 'PC', "#98817B",
ifelse(V(net)$class == 'MP*2', "#402922",
"black"))),
shape = ifelse(V(net)$gender == "F", 21, 22)) +
ggnetwork::theme_blank(legend.position = "none") #put it all together!
#### prep####
rm(list = ls())
gc()
