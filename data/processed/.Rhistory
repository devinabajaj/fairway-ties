grouped_df <- carat_weight %>%
group_by(cut, color) %>%
summarise(mean(price), mean(carat), mean(price_per_carat), median(depth))
carat_weight %>%
filter(cut == "Ideal" & color == "E")%>%
summarise(mean(price_per_carat))
carat_weight %>%
filter(cut == "Premium" & color == "I")%>%
summarise(median(depth))
